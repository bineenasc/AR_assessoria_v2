---
import { faqs } from '../data/site';
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<section id="duvidas" class="section">
  <div class="wrap faq">
    <div>
      <span class="script reveal">Tire suas dúvidas</span>
      <h2 class="reveal">Dúvidas <em>frequentes</em></h2>
      <div class="gold-divider reveal" aria-hidden="true"></div>
    </div>
    <div class="reveal">{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</section>
