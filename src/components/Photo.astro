---
// Procura src/assets/images/<name>.(jpg|jpeg|png|webp|avif). Se existir, o Astro otimiza a foto
// (WebP, vários tamanhos, lazy-loading). Se não existir, mostra um quadro branco "Foto aqui".
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { name: string; label: string; ratio?: string; eager?: boolean; class?: string; sizes?: string }
const { name, label, ratio = '4/5', eager = false, class: cls = '', sizes = '(min-width: 960px) 540px, 100vw' } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const key = Object.keys(files).find((p) => (p.split('/').pop() ?? '').replace(/\.[^.]+$/, '').toLowerCase() === name.toLowerCase());
const img = key ? files[key].default : undefined;
---
{img ? (
  <Image
    src={img}
    alt={label}
    widths={[400, 720, 1080, 1440]}
    sizes={sizes}
    format="webp"
    quality={78}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
    class={`photo ${cls}`}
    style={`aspect-ratio:${ratio}`}
  />
) : (
  <div class={`ph ${cls}`} style={`aspect-ratio:${ratio}`} role="img" aria-label={`Foto aqui: ${label}`} title={`src/assets/images/${name}.jpg`}>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="1.8"/><path d="m21 16-5-5-8 9"/></svg>
    <span>Foto aqui</span>
  </div>
)}
